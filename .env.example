# Copy this to .env and fill in your values
POSTGRES_PASSWORD=aibrandbrain_secure_pass

# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-string

# OpenAI (required for AI generation)
OPENAI_API_KEY=sk-...

# Cloudinary (required for media uploads in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Social Media (add tokens after OAuth flow)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Deployment
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8000
ENVIRONMENT=production
